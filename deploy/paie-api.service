[Unit]
Description=SIVOP Paie - API (FastAPI)
After=network.target postgresql.service

[Service]
User=paie
WorkingDirectory=/opt/paie/backend
ExecStart=/opt/paie/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8105 --workers 2
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
